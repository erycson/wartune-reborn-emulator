# Copie para .env e ajuste. Toda variável é opcional; sem ela vale o padrão de src/wartune_server/config.py.
# Lista completa e explicação: docs/configuracao.md

# Fuso do jogo: virada do dia (5h), agenda dos chefes, createDate das minas, datas dos eventos.
# UTC, deslocamento fixo (+03:00, UTC-7) ou nome IANA (America/Los_Angeles, com horário de verão).
WARTUNE_GAME_TIMEZONE=UTC

# WARTUNE_DATABASE_URL=sqlite+aiosqlite:///data/wartune.db
# WARTUNE_SERVER_ID=1
# WARTUNE_SERVER_NAME=S1 - Local
# WARTUNE_PUBLIC_HOST=127.0.0.1
# WARTUNE_SKIP_TUTORIAL=false
# WARTUNE_GM_SECRET=
