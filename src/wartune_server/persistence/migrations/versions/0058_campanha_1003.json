    "plot": {
     "extend2": 2,
     "plot": {
      "loop": false,
      "sceneType": 3,
      "info": [
       {
        "index": 1,
        "direction": 1,
        "roleId": 19,
        "roleName": "Dinah",
        "event": "",
        "param": "",
        "text": "Just ahead we will find the <font color='#ef0101'><b>Temple of Ibalize</b></font>. A bright light recently showered this long abandoned place. I believe the light may be trying to tell us something."
       },
       {
        "index": 2,
        "direction": 0,
        "roleId": 3,
        "roleName": "{nick}",
        "event": "",
        "param": "",
        "text": "Temple of Ibalize? Is this where the great battle between <font color='#ef0101'><b>Ibalize</b></font> and Aklorn was fought?"
       },
       {
        "index": 3,
        "direction": 1,
        "roleId": 19,
        "roleName": "Dinah",
        "event": "",
        "param": "",
        "text": "Indeed, it is. You do know your history."
       },
       {
        "index": 4,
        "direction": 0,
        "roleId": 3,
        "roleName": "{nick}",
        "event": "",
        "param": "",
        "text": "Everyone should know the story of Aklorn, the last great hero and warrior. Every child should strive to grow up as strong and brave as the mighty Aklorn."
       },
       {
        "index": 5,
        "direction": 1,
        "roleId": 19,
        "roleName": "Dinah",
        "event": "",
        "param": "",
        "text": "Did you have such desires as a child? "
       },
       {
        "index": 6,
        "direction": 0,
        "roleId": 3,
        "roleName": "{nick}",
        "event": "",
        "param": "",
        "text": "*shrugs* I...I suppose. But, what is that on the wind? I feel very....something feels very...unnatual here. "
       },
       {
        "index": 7,
        "direction": 1,
        "roleId": 19,
        "roleName": "Dinah",
        "event": "",
        "param": "",
        "text": "There have been rumors of undead beings gathering here. That is neither life or death you smell, but something much worse. "
       },
       {
        "index": 8,
        "direction": 0,
        "roleId": 3,
        "roleName": "{nick}",
        "event": "",
        "param": "",
        "text": "Undead beings? What do you mean?"
       },
       {
        "index": 9,
        "direction": 1,
        "roleId": 19,
        "roleName": "Dinah",
        "event": "",
        "param": "",
        "text": "There are many races of Undead. Humans, beasts, various races cursed by Ibalize as he fell. They appear to be assembling together for some reason. But a light, perhaps from the Goddess Saliora herself, is shining here. We must follow it."
       }
      ]
     }
